#!/usr/bin/env bash
set -euo pipefail

config_file="${XDG_CONFIG_HOME:-\$HOME/.config}/codex-imagegen/credentials"
env_api_key="${OPENAI_API_KEY:-}"
env_base_url="${OPENAI_BASE_URL:-}"
env_model="${IMAGE_MODEL:-}"
if [[ -r "$config_file" ]]; then
  # shellcheck disable=SC1090
  source "$config_file"
fi
[[ -n "$env_api_key" ]] && OPENAI_API_KEY="$env_api_key"
[[ -n "$env_base_url" ]] && OPENAI_BASE_URL="$env_base_url"
[[ -n "$env_model" ]] && IMAGE_MODEL="$env_model"

model="${IMAGE_MODEL:-gpt-image-2.5-flare}"
base_url="${OPENAI_BASE_URL:-https://www.cctq.ai/v1}"
size="1024x1536"
quality="high"
prompt=""
output=""
references=()

usage() {
  cat <<'EOF'
Usage:
  codex-imagegen --prompt "Describe the image" [--out /path/to/image.png] [options]

Options:
  --model MODEL       Default: gpt-image-2.5-flare; overrides the saved default
  --reference PATH    Add an input/reference image. May be used more than once.
  --size WIDTHxHEIGHT Default: 1024x1536
  --quality QUALITY   Default: high
  --base-url URL      Default: https://www.cctq.ai/v1
  --out PATH          Optional. Default: /home/wengyikun/1/image-<timestamp>.png
  -h, --help          Show this help

Credentials are read from ~/.config/codex-imagegen/credentials or OPENAI_API_KEY.
With --reference, this command calls /images/edits; otherwise it calls
/images/generations. It never sends reasoning_effort.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --prompt) prompt="${2:?Missing prompt value}"; shift 2 ;;
    --out) output="${2:?Missing output path}"; shift 2 ;;
    --model) model="${2:?Missing model value}"; shift 2 ;;
    --reference) references+=("${2:?Missing reference image path}"); shift 2 ;;
    --size) size="${2:?Missing size value}"; shift 2 ;;
    --quality) quality="${2:?Missing quality value}"; shift 2 ;;
    --base-url) base_url="${2:?Missing URL value}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ -n "$prompt" ]] || { printf '%s\n' 'Missing --prompt.' >&2; exit 2; }
for reference in "${references[@]}"; do
  [[ -f "$reference" ]] || { printf 'Reference image not found: %s\n' "$reference" >&2; exit 2; }
done
if [[ -z "$output" ]]; then
  output="/home/wengyikun/1/image-$(date +%Y%m%d-%H%M%S).png"
fi
[[ -n "${OPENAI_API_KEY:-}" ]] || { printf '%s\n' "Set OPENAI_API_KEY or create $config_file." >&2; exit 2; }
[[ ! -e "$output" ]] || { printf 'Refusing to overwrite existing file: %s\n' "$output" >&2; exit 2; }

mkdir -p "$(dirname "$output")"
response_file="$(mktemp)"
trap 'rm -f "$response_file"' EXIT

if [[ ${#references[@]} -eq 0 ]]; then
  payload="$(jq -n --arg model "$model" --arg prompt "$prompt" --arg size "$size" --arg quality "$quality" '{model:$model,prompt:$prompt,size:$size,quality:$quality}')"
  if ! curl --fail-with-body --silent --show-error \
    "${base_url%/}/images/generations" \
    -H "Authorization: Bearer $OPENAI_API_KEY" \
    -H 'Content-Type: application/json' \
    --data "$payload" \
    --output "$response_file"; then
    jq -r '.error.message // empty' "$response_file" 2>/dev/null || true
    exit 1
  fi
else
  curl_args=(--form "model=$model" --form "prompt=$prompt" --form "size=$size" --form "quality=$quality")
  for reference in "${references[@]}"; do
    curl_args+=(--form "image[]=@$reference")
  done
  if ! curl --fail-with-body --silent --show-error \
    "${base_url%/}/images/edits" \
    -H "Authorization: Bearer $OPENAI_API_KEY" \
    "${curl_args[@]}" \
    --output "$response_file"; then
    jq -r '.error.message // empty' "$response_file" 2>/dev/null || true
    exit 1
  fi
fi

jq -e -r '.data[0].b64_json' "$response_file" | base64 --decode > "$output"
[[ -s "$output" ]] || { printf '%s\n' 'Image API returned no image data.' >&2; exit 1; }
printf 'Wrote %s\n' "$output"
